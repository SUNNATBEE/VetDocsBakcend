# ───────── Dependencies ─────────
node_modules/

# ───────── Environment / secrets ─────────
.env
.env.*
!.env.example

# ───────── Logs ─────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
logs/

# ───────── Local databases (do not commit) ─────────
*.db
*.db-journal
*.sqlite
*.sqlite3
prisma/dev.db
prisma/*.db

# ───────── Build / cache ─────────
dist/
build/
coverage/
.cache/
.tmp/
.nyc_output/

# ───────── Playwright e2e artifacts ─────────
test-results/
playwright-report/
playwright/.cache/
tests/e2e/.snapshots/

# ───────── Prisma generated client (always regenerated) ─────────
node_modules/.prisma/
node_modules/@prisma/client/

# ───────── OS / editor junk ─────────
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
.idea/
.vscode/
*.swp
*.swo

# ───────── Platform-specific ─────────
.vercel
.railway
.netlify

# ───────── Misc ─────────
*.pem
*.key
*.crt
