{
  "name": "vetclinicbacken",
  "version": "1.0.0",
  "description": "O‘zbekiston veterinariya klinikalari API (Express + Postgres + Prisma)",
  "main": "src/server.js",
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=9.0.0"
  },
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "start:prod": "node src/server.js",
    "build": "prisma generate",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:reset": "prisma migrate reset",
    "db:seed": "node prisma/seed.js",
    "db:studio": "prisma studio",
    "prepare": "husky || true",
    "check:js": "node --check src/server.js && node --check src/app.js",
    "lint": "eslint src tests prisma/seed.js",
    "format": "prettier --write \"src/**/*.js\" \"tests/**/*.js\"",
    "format:check": "prettier --check \"src/**/*.js\" \"tests/**/*.js\"",
    "codegen:openapi": "openapi-typescript docs/openapi.yaml -o types/openapi.d.ts",
    "test": "jest --runInBand",
    "test:integration": "jest --runInBand tests/integration",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui"
  },
  "keywords": [
    "vet",
    "clinic",
    "express",
    "postgres",
    "prisma",
    "uzbekistan",
    "openapi",
    "railway"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@prisma/client": "^6.8.2",
    "bcryptjs": "^3.0.2",
    "compression": "^1.8.0",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^5.2.1",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "prisma": "^6.8.2",
    "prom-client": "^15.1.3",
    "swagger-ui-express": "^5.0.1",
    "yaml": "^2.7.0",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "eslint": "^9.15.0",
    "eslint-config-prettier": "^9.1.0",
    "globals": "^15.11.0",
    "husky": "^9.1.7",
    "jest": "^30.3.0",
    "lint-staged": "^17.0.0",
    "nodemon": "^3.1.10",
    "openapi-typescript": "^7.4.4",
    "prettier": "^3.4.2",
    "supertest": "^7.2.2"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "lint-staged": {
    "{src,tests}/**/*.js": "eslint --max-warnings=0",
    "prisma/seed.js": "eslint --max-warnings=0"
  }
}
