# =============================================================================
# Vet Clinic API — Environment variables (Supabase + Railway production)
# =============================================================================
# Lokal ish uchun: `cp .env.example .env` va qiymatlarni to'ldiring.
# Productionda: Railway dashboard → Variables bo'limiga kiriting (.env push qilmang).
# =============================================================================


# ─── Database (Supabase Postgres) ────────────────────────────────────────────
# Supabase dashboard → Project Settings → Database → "Connection string"
#
# DATABASE_URL  — runtime so'rovlar uchun "Transaction" pooler (port 6543).
#                 Prisma uchun `?pgbouncer=true&connection_limit=1` SHART.
# DATABASE_DIRECT_URL — migratsiya uchun "Session" / direct ulanish (port 5432).
#                 Prisma `migrate deploy` faqat shu URL orqali ishlaydi.
#
# Ikkala URL ham `sslmode=require` bilan tugashi kerak.
# Parolda maxsus belgilar bo'lsa — URL-encoded shaklda yozing.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-<zone>-<region>.pooler.supabase.com:6543/postgres?sslmode=require&pgbouncer=true&connection_limit=1"
DATABASE_DIRECT_URL="postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres?sslmode=require"


# ─── Server ──────────────────────────────────────────────────────────────────
# Railway PORT'ni avtomatik beradi — productionda bu qatorni QO'YMANG.
PORT=4000
NODE_ENV=development


# ─── JWT ─────────────────────────────────────────────────────────────────────
# Productionda kuchli tasodifiy 32+ belgili kalit shart. Generatsiya:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET="REPLACE-WITH-STRONG-RANDOM-32+chars"
ACCESS_TOKEN_EXPIRES_MINUTES=15
REFRESH_TOKEN_EXPIRES_DAYS=14


# ─── CORS ────────────────────────────────────────────────────────────────────
# Vergul bilan bir nechta origin yozsa bo'ladi. Productionda "*" tavsiya etilmaydi.
CORS_ORIGIN="http://localhost:3000"


# ─── Public URL ──────────────────────────────────────────────────────────────
# Swagger / root javobdagi havolalar uchun.
# Railway: service Settings → Networking → Generate Domain natijasi.
API_PUBLIC_URL="http://localhost:4000"


# ─── Toggles ─────────────────────────────────────────────────────────────────
# Productionda Swagger'ni `false` qilish odatiy amaliyot (xohlasangiz qoldiring).
ENABLE_SWAGGER=true
# Railway ortida proxy bor — productionda HAR DOIM `true`.
TRUST_PROXY=true


# ─── Rate limit ──────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_WINDOW_MINUTES=15
AUTH_RATE_LIMIT_MAX=40


# ─── Seed (faqat birinchi ishga tushganda kerak) ─────────────────────────────
# Production seed'idan keyin admin parolini DARHOL almashtiring.
SEED_ADMIN_EMAIL="admin@vetclinic.uz"
SEED_ADMIN_PASSWORD="Admin12345!"
SEED_ADMIN_NAME="Vet Clinic Admin"
