# Frontend environment variables
# Copy to .env.local in your frontend repository

# API
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Vet Clinic

# Maps
NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
NEXT_PUBLIC_MAP_ATTRIBUTION=© OpenStreetMap contributors

# Optional analytics/monitoring (set only when used)
# NEXT_PUBLIC_SENTRY_DSN=
# NEXT_PUBLIC_GA_ID=

# Feature flags
NEXT_PUBLIC_ENABLE_ADMIN=true
NEXT_PUBLIC_ENABLE_MAP=true
NEXT_PUBLIC_ENABLE_FAVORITES=true
